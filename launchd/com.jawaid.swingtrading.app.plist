<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the SwingTrading app running at http://localhost:8502: starts it at login and
     restarts it if it stops. Installed by scripts/install_launchd.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jawaid.swingtrading.app</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/jawaidekram/.local/bin/uv</string>
		<string>run</string>
		<string>swing</string>
		<string>app</string>
		<string>--port</string>
		<string>8502</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/jawaidekram/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/jawaidekram/Projects/SwingTrading</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/jawaidekram/Projects/SwingTrading/data/logs/app_server.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jawaidekram/Projects/SwingTrading/data/logs/app_server.log</string>
</dict>
</plist>
